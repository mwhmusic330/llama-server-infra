# Copy to .env and adjust. Values here are placeholders.

# llama.cpp OpenAI-compatible endpoint (same host as the proxy, or remote)
LLAMA_CPP_INTERNAL_URL=http://127.0.0.1:8080/v1

# Ollama embedding server (Docker node)
OLLAMA_DOCKER_NODE_URL=http://DOCKER_NODE_IP:11434

# Models
MEM0_EMBED_MODEL=bge-large:latest
MEM0_LLM_MODEL=qwen3.5-9b

# Memory scope and retrieval
MEM0_USER_ID=default_user
MEM0_TOP_K=5
MEM0_SEARCH_TIMEOUT=15

# Skip memory for tool-less requests (title/summary/compaction calls from opencode)
MEM0_SKIP_NO_TOOLS=true

# Cap on text embedded per exchange
MEM0_MAX_STORE_CHARS=4000

# Proxy listen port
MEM0_PROXY_PORT=8000

# Optional: Chroma storage path (defaults to ./mem0_storage next to proxy.py)
# MEM0_CHROMA_PATH=/opt/mem0-proxy/mem0_storage

# Optional: silence mem0 telemetry
ANONYMIZED_TELEMETRY=false
